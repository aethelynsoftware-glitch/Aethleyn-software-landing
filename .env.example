# Variables públicas del frontend (pueden aparecer en el bundle del navegador).
# Completa con los valores del proyecto Supabase correspondiente.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# No coloques aquí SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY ni otros secretos.
# Configúralos en Supabase Edge Function Secrets.
